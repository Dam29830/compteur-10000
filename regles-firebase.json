{
  "rules": {
    "parties": {
      "$code": {
        ".read": true,
        "evenements": {
          "$id": {
            ".write": "!data.exists() && $code.length == 4 && $code.matches(/^[A-HJKMNP-Z2-9]+$/) && $id.length <= 32",
            ".validate": "newData.hasChildren(['type', 't'])",
            "type": { ".validate": "newData.isString() && newData.val().matches(/^[a-z]+$/) && newData.val().length <= 16" },
            "t": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "nom": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24" },
            "j": { ".validate": "newData.isString() && newData.val().length <= 32" },
            "pts": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
            "par": { ".validate": "newData.isString() && newData.val().length <= 32" },
            "tour": { ".validate": "newData.isString() && newData.val().length <= 32" },
            "cle": {
              ".validate": "newData.val() == 'objectif' || newData.val() == 'entree' || newData.val() == 'minTour' || newData.val() == 'pile' || newData.val() == 'troisCroix'"
            },
            "valeur": { ".validate": "newData.isNumber() || newData.isBoolean()" },
            "garder": { ".validate": "newData.isBoolean()" },
            "$autre": { ".validate": false }
          }
        }
      }
    }
  }
}
